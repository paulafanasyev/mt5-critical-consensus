APP_ENV=development
BIND_HOST=127.0.0.1
BIND_PORT=8000
POLICY_DIR=./config
# Replace the password below with the exact same URL-safe value as POSTGRES_PASSWORD before using a DB adapter.
DATABASE_URL=postgresql://cc_user:REPLACE_WITH_POSTGRES_PASSWORD@127.0.0.1:5432/critical_consensus
REDIS_URL=redis://127.0.0.1:6379/0
# Put secrets in a secret manager/environment; never commit real credentials.
MT5_BRIDGE_TOKEN=
EXECUTION_ENABLED=false
LIVE_EXECUTION_ENABLED=false

# Set distinct, unique local development secrets before running docker compose.
POSTGRES_PASSWORD=
NEO4J_PASSWORD=
