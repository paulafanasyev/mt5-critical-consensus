APP_ENV=development
BIND_HOST=127.0.0.1
BIND_PORT=8000
POLICY_DIR=./config
# Replace the password below with the exact same URL-safe value as POSTGRES_PASSWORD before using a DB adapter.
DATABASE_URL=postgresql://cc_user:REPLACE_WITH_POSTGRES_PASSWORD@127.0.0.1:5432/critical_consensus
REDIS_URL=redis://127.0.0.1:6379/0
# Put secrets in a secret manager/environment; never commit real credentials.
# At least 24 characters of [A-Za-z0-9._~-]; it is an HTTP header value, not a user 2FA factor.
MT5_BRIDGE_TOKEN=
# Three distinct keys, 32..256 bytes each, with three distinct issuers. Evidence signs ingress
# bundles; governance signs calibration-service attestations; operator signs human approvals
# in a separate domain. None may share a key or issuer with another.
MT5_EVIDENCE_HMAC_KEY=
MT5_GOVERNANCE_HMAC_KEY=
MT5_OPERATOR_HMAC_KEY=
MT5_EVIDENCE_ISSUER=trusted-ingress
MT5_GOVERNANCE_ISSUER=calibration-service
MT5_OPERATOR_ISSUER=operator-console
# Optional separate administrator secret required to disable the kill switch.
MT5_KILL_SWITCH_ADMIN_TOKEN=
# Provider keys are referenced by api_key_env and must use the MT5_AGENT_KEY_* namespace.
# MT5_AGENT_KEY_EXAMPLE=
# JSON array of provider specs; api_key_env values must match ^MT5_AGENT_KEY_[A-Z0-9_]{1,64}$.
# MT5_AGENT_PROVIDERS=[{"agent_id":"PlatformScoutAgent","role":"analyst","independence_group":"vendor-platform","model":"YOUR_MODEL","api_key_env":"MT5_AGENT_KEY_PLATFORM","base_url":"https://provider.example/v1"}]
# Redis stream consumed by scripts/run_worker.py (durable PostgreSQL writer, not an order dispatcher).
CC_STREAM=cc:signals:v1
CC_CONSUMER_GROUP=cc-durable-writer-v1
CC_CONSUMER_NAME=worker-1
# There is intentionally no execution toggle: API and EA hard-code execution disabled and derive
# demo/live status only from the broker account and policy matrix.

# Set distinct, unique local development secrets before running docker compose.
POSTGRES_PASSWORD=
NEO4J_PASSWORD=
