{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/critical-consensus/peer_review.schema.json",
  "title": "Peer Review",
  "description": "Anonymous peer review; CHALLENGE must contain concrete evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["review_id", "target_verdict_id", "stance", "challenge_type", "argument", "evidence_refs", "created_at", "reviewer_alias", "status"],
  "properties": {
    "review_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "target_verdict_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "stance": {"enum": ["CONFIRM", "CHALLENGE"]},
    "challenge_type": {"enum": ["DATA_CONTRADICTION", "SOURCE_WEAK", "STALE_DATA", "LOGIC_GAP", "REGIME_MISMATCH", "CORRELATION_RISK", "NONE"]},
    "argument": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "pattern": "\\S"}},
    "created_at": {"type": "string", "format": "date-time"},
    "reviewer_alias": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "status": {"const": "VALIDATED"}
  },
  "allOf": [{"if": {"properties": {"stance": {"const": "CONFIRM"}}, "required": ["stance"]}, "then": {"properties": {"challenge_type": {"const": "NONE"}}}, "else": {"properties": {"challenge_type": {"enum": ["DATA_CONTRADICTION", "SOURCE_WEAK", "STALE_DATA", "LOGIC_GAP", "REGIME_MISMATCH", "CORRELATION_RISK"]}}}}]
}
