{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/critical-consensus/certainty_report.schema.json",
  "title": "Certainty Report",
  "description": "Gate result; PASS only forwards to ChiefAgent, never directly trades.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_id",
    "signal_id",
    "status",
    "passed",
    "checks",
    "blockers",
    "consensus_score",
    "created_at"
  ],
  "properties": {
    "report_id": {
      "type": "string"
    },
    "signal_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "PASS",
        "GATHER_MORE",
        "ESCALATE"
      ]
    },
    "passed": {
      "type": "boolean"
    },
    "checks": {
      "type": "object"
    },
    "blockers": {
      "type": "array"
    },
    "consensus_score": {
      "type": "number"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "input_hash": {
      "type": "string"
    },
    "trade_allowed": {
      "const": false
    }
  }
}