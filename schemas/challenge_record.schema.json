{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/critical-consensus/challenge_record.schema.json",
  "title": "Challenge Record",
  "description": "Open challenge blocks CertaintyGate; at most three evidence-backed resolution rounds.",
  "type": "object",
  "additionalProperties": false,
  "required": ["challenge_id", "target_verdict_id", "challenge_type", "status", "argument", "evidence_refs", "rounds", "created_at"],
  "properties": {
    "challenge_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "target_verdict_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "challenge_type": {"enum": ["DATA_CONTRADICTION", "SOURCE_WEAK", "STALE_DATA", "LOGIC_GAP", "REGIME_MISMATCH", "CORRELATION_RISK"]},
    "status": {"enum": ["OPEN", "RESOLVED", "ESCALATED"]},
    "argument": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "pattern": "\\S"}},
    "rounds": {"type": "array", "maxItems": 3, "items": {"type": "object", "required": ["round", "response", "evidence_refs"], "properties": {"round": {"type": "integer", "minimum": 1, "maximum": 3}, "response": {"type": "string", "minLength": 1, "pattern": "\\S"}, "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "pattern": "\\S"}}, "status": {"enum": ["OPEN", "RESOLVED", "ESCALATED"]}}, "additionalProperties": false}},
    "created_at": {"type": "string", "format": "date-time"},
    "resolved_at": {"type": "string", "format": "date-time"},
    "resolution_evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "pattern": "\\S"}}
  },
  "allOf": [{"if": {"properties": {"status": {"const": "RESOLVED"}}, "required": ["status"]}, "then": {"required": ["resolved_at", "resolution_evidence_refs"], "properties": {"rounds": {"minItems": 1}}}}]
}
