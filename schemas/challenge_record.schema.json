{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/critical-consensus/challenge_record.schema.json",
  "title": "Challenge Record",
  "description": "Open challenge blocks CertaintyGate; max three resolution rounds.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "challenge_id",
    "target_verdict_id",
    "challenge_type",
    "status",
    "argument",
    "evidence_refs",
    "rounds",
    "created_at"
  ],
  "properties": {
    "challenge_id": {
      "type": "string"
    },
    "target_verdict_id": {
      "type": "string"
    },
    "challenge_type": {
      "type": "string"
    },
    "status": {
      "enum": [
        "OPEN",
        "RESOLVED",
        "ESCALATED"
      ]
    },
    "argument": {
      "type": "string"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rounds": {
      "type": "array"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    },
    "resolution_evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}