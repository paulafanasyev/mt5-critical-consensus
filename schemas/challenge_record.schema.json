{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/critical-consensus/challenge_record.schema.json",
  "title": "Challenge Record",
  "description": "Open challenge blocks CertaintyGate; at most three typed resolution rounds.",
  "type": "object",
  "additionalProperties": false,
  "required": ["challenge_id", "target_verdict_id", "challenge_type", "status", "argument", "evidence_refs", "rounds", "created_at"],
  "properties": {
    "challenge_id": {"type": "string", "minLength": 1},
    "target_verdict_id": {"type": "string", "minLength": 1},
    "challenge_type": {"enum": ["DATA_CONTRADICTION", "SOURCE_WEAK", "STALE_DATA", "LOGIC_GAP", "REGIME_MISMATCH", "CORRELATION_RISK"]},
    "status": {"enum": ["OPEN", "RESOLVED", "ESCALATED"]},
    "argument": {"type": "string", "minLength": 1},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "rounds": {"type": "array", "maxItems": 3, "items": {"type": "object"}},
    "created_at": {"type": "string", "format": "date-time"},
    "resolved_at": {"type": "string", "format": "date-time"},
    "resolution_evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "RESOLVED"}}, "required": ["status"]}, "then": {"required": ["resolved_at", "resolution_evidence_refs"]}}
  ]
}
