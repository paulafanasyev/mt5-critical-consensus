{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/critical-consensus/chief_reasoning.schema.json",
  "title": "Chief Reasoning",
  "description": "ChiefAgent must complete all steps a-i before CONFIRM.",
  "type": "object",
  "additionalProperties": false,
  "required": ["reasoning_id","signal_id","verdict","reasons_against","steps","open_challenges","tail_risk_probability","tail_risk_scenarios","reasoning_hash","created_at","all_challenges_read","challenge_ledger_snapshot","challenge_ledger_hash","reviewed_challenge_ids"],
  "properties": {
    "reasoning_id": {"type": "string"},
    "signal_id": {"type": "string"},
    "verdict": {"enum": ["CONFIRM","HOLD","REJECT"]},
    "steps": {"type": "object", "required": ["a","b","c","d","e","f","g","h","i"], "properties": {
      "a": {"type":"object","required":["passed","detail","evidence_refs"],"properties":{"passed":{"type":"boolean"},"detail":{"type":"string"},"evidence_refs":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}}},"additionalProperties":false},
      "b": {"type":"object","required":["passed","detail","evidence_refs"],"properties":{"passed":{"type":"boolean"},"detail":{"type":"string"},"evidence_refs":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}}},"additionalProperties":false},
      "c": {"type":"object","required":["passed","detail","evidence_refs"],"properties":{"passed":{"type":"boolean"},"detail":{"type":"string"},"evidence_refs":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}}},"additionalProperties":false},
      "d": {"type":"object","required":["passed","detail","evidence_refs"],"properties":{"passed":{"type":"boolean"},"detail":{"type":"string"},"evidence_refs":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}}},"additionalProperties":false},
      "e": {"type":"object","required":["passed","detail","evidence_refs"],"properties":{"passed":{"type":"boolean"},"detail":{"type":"string"},"evidence_refs":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}}},"additionalProperties":false},
      "f": {"type":"object","required":["passed","detail","evidence_refs"],"properties":{"passed":{"type":"boolean"},"detail":{"type":"string"},"evidence_refs":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}}},"additionalProperties":false},
      "g": {"type":"object","required":["passed","detail","evidence_refs"],"properties":{"passed":{"type":"boolean"},"detail":{"type":"string"},"evidence_refs":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}}},"additionalProperties":false},
      "h": {"type":"object","required":["passed","detail","evidence_refs"],"properties":{"passed":{"type":"boolean"},"detail":{"type":"string"},"evidence_refs":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}}},"additionalProperties":false},
      "i": {"type":"object","required":["passed","detail","evidence_refs"],"properties":{"passed":{"type":"boolean"},"detail":{"type":"string"},"evidence_refs":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}}},"additionalProperties":false}
    },"additionalProperties":false},
    "open_challenges":{"type":"array"},
    "tail_risk_probability":{"type":"number","minimum":0,"maximum":1},
    "reasoning_hash":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "created_at":{"type":"string","format":"date-time"},
    "resolved_challenge_refs":{"type":"array","items":{"type":"string"}},
    "reasons_against":{"type":"array","minItems":5,"items":{"type":"string","minLength":1},"uniqueItems":true},
    "all_challenges_read":{"type":"boolean","const":true},
    "challenge_ledger_snapshot":{"type":"array","items":{"type":"object","required":["challenge_id"],"properties":{"challenge_id":{"type":"string","minLength":1},"status":{"enum":["OPEN","RESOLVED","ESCALATED"]},"target_verdict_id":{"type":"string"},"challenge_type":{"type":"string"},"evidence_refs":{"type":"array","items":{"type":"string"}},"resolution_evidence_refs":{"type":"array","items":{"type":"string"}}},"additionalProperties":true}},
    "challenge_ledger_hash":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "reviewed_challenge_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
    "tail_risk_scenarios":{"type":"array","minItems":1,"items":{"type":"object","required":["scenario","probability","impact","evidence_refs"],"properties":{"scenario":{"type":"string","minLength":1},"probability":{"type":"number","minimum":0,"maximum":1},"impact":{"type":"string","minLength":1},"mitigation":{"type":"string"},"evidence_refs":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}}},"additionalProperties":false}
  }
}
