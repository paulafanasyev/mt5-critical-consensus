{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/critical-consensus/user_decision.schema.json",
  "title": "User Decision",
  "description": "Explicit human decision. Live requires 2FA and signature verification.",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision_id", "permission_id", "user_id", "decision", "timestamp", "reason", "ttl_seconds"],
  "properties": {
    "decision_id": {"type": "string", "minLength": 1},
    "permission_id": {"type": "string", "minLength": 1},
    "user_id": {"type": "string", "minLength": 1},
    "decision": {"enum": ["APPROVE", "REJECT"]},
    "timestamp": {"type": "string", "format": "date-time"},
    "reason": {"type": "string", "minLength": 1},
    "ttl_seconds": {"type": "integer", "minimum": 1, "maximum": 600},
    "two_fa_verified": {"type": "boolean"},
    "signature_verified": {"type": "boolean"},
    "ip_hash": {"type": "string"}
  }
}
